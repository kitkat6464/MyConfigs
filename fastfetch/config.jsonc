{
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
                "logo": {
                    "source": "~/.config/fastfetch/ascii.txt",
                    "height": 15,
                    "width": 30,
                    "padding": {
                        "top": 5,
                        "left": 4,
                        "right": 4
                    }
        },
        "display": {
            "separator": " ► ",
            "bar": {
            "char": {
            "elapsed": "",
            "total": ""
        },
            "width": 4
        },
    
            "percent": {
                "type": 2
            }
        },
        "modules": [
            "break",
            "break",
            {
                "type": "title",
                "format": " 👑 {1}@{2} 👑",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            {
                "type": "custom",
                "format": "System:",
            },
            {
                "type": "os",
                "key": " OS  ",
            },
            {
                "type": "kernel",
                "key": " KRNL",
            },
            {
                "type": "packages",
                "key": " PKGS",
            },
            {
                "type": "shell",
                "key": " SH  ",
            },
            {
                "type": "uptime",
                "key": " UP  ",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            {
                "type": "custom",
                "format": "Desktop:",
            },
            {
                "type": "de",
                "key": " DE  ",
            },
            {
                "type": "wm",
                "key": " WM  ",
            },
            {
                "type": "lm",
                "key": " LM  ",
            },
            {
                "type": "wmtheme",
                "key": " THM ",
            },
            {
                "type": "icons",
                "key": " ICO ",
            },
            {
                "type": "terminal",
                "key": " TERM",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            {
                "type": "custom",
                "format": "Hardware:",
            },
            {
                "type": "host",
                "key": " HST ",
            },
            {
                "type": "cpu",
                "key": " CPU ",
                "format": "{1}"
            },
            {
                "type": "gpu",
                "key": " GPU ",
            },
            {
                "type": "disk",
                "key": " DSK ",
            },
            {
                "type": "memory",
                "key": " RAM ",
            },
            {
                "type": "swap",
                "key": " SWP ",
            },
            {
                "type": "custom",
                "format": "───────────────────────────────────────────────────",
            },
            ]
}
