#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

[[ $EUID -eq 0 ]] && error "Do not run as root."

#---------------------------------------------------#
# Section 1 - Updating Stage                        #
#---------------------------------------------------#

info "Updating System..."
sudo pacman -Syu --noconfirm

#---------------------------------------------------#
# Section 2 - Graphical Target Stage                #
#---------------------------------------------------#

info "Enabling Graphical Target..."
sudo systemctl set-default graphical.target

#---------------------------------------------------#
# Section 3 - Installation Stage                    #
#---------------------------------------------------#
    
info "Installing Cosmic Desktop..."
sudo pacman -S --noconfirm \
    cosmic-app-library \
    cosmic-applets \
    cosmic-bg \
    cosmic-comp \
    cosmic-files \
    cosmic-greeter \
    cosmic-idle \
    cosmic-initial-setup \
    cosmic-launcher \
    cosmic-monitor \
    cosmic-notifications \
    cosmic-osd \
    cosmic-osk \
    cosmic-panel \
    cosmic-player \
    cosmic-randr \
    cosmic-screenshot \
    cosmic-session \
    cosmic-settings \
    cosmic-settings-daemon \
    cosmic-sound-theme \
    cosmic-store \
    cosmic-terminal \
    cosmic-text-editor \
    cosmic-viewer \
    cosmic-wallpapers \
    cosmic-workspaces
    
info "Installing XDG Portal Essentials..."
sudo pacman -S --noconfirm \
    gnome-keyring \
    xdg-desktop-portal-gtk \
    xdg-desktop-portal-cosmic

info "Installing Gnome App Essentials..."
sudo pacman -S --noconfirm \
    papers \
    gnome-logs \
    gnome-calendar \
    gnome-calculator \
    gnome-disk-utility

info "Installing Gaming Essentials..."
sudo pacman -S --noconfirm \
    cachyos-gaming-applications \
    cachyos-gaming-meta
    
info "Installing ScopeBuddy For GameScope..."
sudo wget -O /usr/local/bin/scopebuddy https://raw.githubusercontent.com/OpenGamingCollective/ScopeBuddy/refs/tags/1.5.0/bin/scopebuddy
sudo chmod +x /usr/local/bin/scopebuddy
sudo ln -s scopebuddy /usr/local/bin/scb

#---------------------------------------------------#
# Section 4 - Configuration Stage                   #
#---------------------------------------------------#

info "Setting Up Dot Files..."
cp -R fastfetch scopebuddy ~/.config/

#---------------------------------------------------#
# Section 5 - Enabling Services Stage               #
#---------------------------------------------------#

info "Enabling Cosmic Greeter..."
sudo systemctl enable cosmic-greeter

#---------------------------------------------------#
# Section 6  - Completion Stage                     #
#---------------------------------------------------#

info "Checking For Updates Again..."
sudo pacman -Syu --noconfirm

echo ""
echo -e "${GREEN}================================${NC}"
echo -e "${GREEN} Setup Complete! Please Reboot. ${NC}"
echo -e "${GREEN}================================${NC}"
