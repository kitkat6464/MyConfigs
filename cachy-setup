#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

[[ $EUID -eq 0 ]] && error "Do not run as root."

#---------------------------------------------------#
# Section 1 - Updating Stage                        #
#---------------------------------------------------#

info "Updating System..."
sudo pacman -Syu --noconfirm

#---------------------------------------------------#
# Section 2 - Graphical Target Stage                #
#---------------------------------------------------#

info "Enabling Graphical Target..."
sudo systemctl set-default graphical.target

#---------------------------------------------------#
# Section 3 - Installation Stage                    #
#---------------------------------------------------#

info "Installing Noctalia Greeter..."
sudo pacman -S --noconfirm noctalia-greeter

info "Installing MangoWM..."
sudo pacman -S --noconfirm mangowm
    
info "Installing MangoWM Essentials..."
sudo pacman -S --noconfirm wlr-randr
    
info "Installing XDG Portal Essentials..."
sudo pacman -S --noconfirm \
    gnome-keyring \
    xdg-desktop-portal-gtk \
    xdg-desktop-portal-wlr

info "Installing Noctalia Shell..."
sudo pacman -S --noconfirm noctalia
    
info "Installing Noctalia Shell Essentials..."
sudo pacman -S --noconfirm \
    ddcutil \
    qt5ct \
    qt6ct \
    nwg-look \
    adw-gtk-theme

info "Installing Gnome App Essentials..."
sudo pacman -S --noconfirm \
    loupe \
    papers \
    showtime \
	decibels \
	nautilus \
    gnome-logs \
    gnome-calendar \
    gnome-calculator \
    gnome-text-editor \
    gnome-disk-utility \
    gnome-system-monitor
    
info "Installing Kitty, and Bazaar..."
sudo pacman -S --noconfirm \
    kitty \
    bazaar

info "Installing Gaming Essentials..."
sudo pacman -S --noconfirm \
    cachyos-gaming-applications \
    cachyos-gaming-meta
    
info "Installing ScopeBuddy For GameScope..."
sudo wget -O /usr/local/bin/scopebuddy https://raw.githubusercontent.com/OpenGamingCollective/ScopeBuddy/refs/tags/1.5.0/bin/scopebuddy
sudo chmod +x /usr/local/bin/scopebuddy
sudo ln -s scopebuddy /usr/local/bin/scb

#---------------------------------------------------#
# Section 4 - Configuration Stage                   #
#---------------------------------------------------#

info "Setting Up Noctalia Greeter..."
sudo mkdir -p /etc/greetd
sudo usermod -aG video,render greeter
sudo chown -R greeter:greeter /etc/greetd/
sudo cp -a /etc/greetd/config.toml /etc/greetd/config.toml.bak
sudo tee /etc/greetd/config.toml > /dev/null <<'EOF'
[terminal]
vt = 1

[default_session]
command = "/usr/bin/noctalia-greeter-session"
user = "greeter"
EOF
sudo chmod 644 /etc/greetd/config.toml

info "Setting Up Dot Files..."
cp -R fastfetch mango scopebuddy xdg-desktop-portal-wlr xdg-desktop-portal mimeapps.list ~/.config/

#---------------------------------------------------#
# Section 5 - Enabling Services Stage               #
#---------------------------------------------------#

info "Enabling Noctalia Greeter..."
sudo systemctl enable greetd

#---------------------------------------------------#
# Section 6  - Completion Stage                     #
#---------------------------------------------------#

info "Checking For Updates Again..."
sudo pacman -Syu --noconfirm

echo ""
echo -e "${GREEN}================================${NC}"
echo -e "${GREEN} Setup Complete! Please Reboot. ${NC}"
echo -e "${GREEN}================================${NC}"
