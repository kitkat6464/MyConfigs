#!/usr/bin/env bash

#---------------------------------------------------#
# Start - Catrina's Post Setup                      #
#---------------------------------------------------#

#---------------------------------------------------#
# Section 0 - Pre Flight                            #
#---------------------------------------------------#

echo
echo "Refreshing Repos"
echo

sudo pacman -Syu --noconfirm

echo
echo "Done!"
echo

echo
echo "Enabling Graphical Target"
echo

sudo systemctl set-default graphical.target

echo
echo "Done!"
echo

#---------------------------------------------------#
# Section 1 - Noctalia Greeter Setup                #
#---------------------------------------------------#

echo
echo "Installing Noctalia Greeter"
echo

PKGS=(
	'noctalia-greeter'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

echo
echo "Configuring Noctalia Greeter"
echo

sudo mkdir -p /etc/greetd
sudo chown -R greeter:greeter /etc/greetd/
sudo usermod -aG video,render greeter
sudo cp -a /etc/greetd/config.toml /etc/greetd/config.toml.bak
sudo wget -O /etc/greetd/config.toml https://raw.githubusercontent.com/kitkat6464/MyConfigs/refs/heads/mango/sys_cfgs/greetd/config.toml
sudo chmod 644 /etc/greetd/config.toml

echo
echo "Done!"
echo

echo
echo "Enabling Noctalia Greeter"
echo

sudo systemctl enable greetd

echo
echo "Done!"
echo

#---------------------------------------------------#
# Section 2 - Umbriel Setup                         #
#---------------------------------------------------#

echo
echo "Installing Extra Umbriel Dependencies"
echo

PKGS=(
	'gnome-keyring'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

#---------------------------------------------------#
# Section 3 - Noctalia Shell Setup                  #
#---------------------------------------------------#

echo
echo "Installing Noctalia Shell and Dependencies"
echo

PKGS=(
	'noctalia'
	'ddcutil'
	'cliphist'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

echo
echo "Installing Theming Tools"
echo

PKGS=(
	'qt6ct'
	'nwg-look'
	'adw-gtk-theme'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

#---------------------------------------------------#
# Section 4 - Core Apps Setup                       #
#---------------------------------------------------#

echo
echo "Installing Gnome Core Apps"
echo

PKGS=(
	'loupe'
	'papers'
	'showtime'
	'decibels'
	'nautilus'
	'gnome-logs'
	'gnome-calendar'
	'gnome-text-editor'
	'gnome-disk-utility'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

echo
echo "Installing Gnome Circle Apps"
echo

PKGS=(
	'bazaar'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

echo
echo "Installing Additional Apps"
echo

PKGS=(
	'kitty'
	'fastfetch'
)

for PKG in "${PKGS[@]}"; do
	echo "INSTALLING: ${PKG}"
	sudo pacman -S "$PKG" --noconfirm --needed
done

echo
echo "Done!"
echo

#---------------------------------------------------#
# Section 5 - Custom Config Setup                   #
#---------------------------------------------------#

echo
echo "Configuring Custom Configs"
echo

mkdir -p ~/.config/umbriel
curl -Lo $HOME/.config/mimeapps.list https://raw.githubusercontent.com/kitkat6464/MyConfigs/refs/heads/mango/.config/mimeapps.list
curl -Lo $HOME/.config/umbriel/config.toml https://raw.githubusercontent.com/kitkat6464/MyConfigs/refs/heads/umbriel/.config/umbriel/config.toml

echo
echo "Done!"
echo

#---------------------------------------------------#
# Section 7 - Post Flight                           #
#---------------------------------------------------#

echo
echo "Refreshing Repos Again"
echo

sudo pacman -Syu --noconfirm

echo
echo "Done!"
echo

#---------------------------------------------------#
# End - Catrina's Post Setup                        #
#---------------------------------------------------#
